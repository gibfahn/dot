#!/usr/bin/env bash

set -euo pipefail

set -x

# Set up gpg agent Keychain integration.
# https://stackoverflow.com/questions/39494631/gpg-failed-to-sign-the-data-fatal-failed-to-write-commit-object-git-2-10-0

gnupg_home=${GNUPGHOME:-$HOME/.gnupg}

mkdir -p -m 700 "$gnupg_home"
pinentry_mac_path=$(which pinentry-mac) # Expect it to be in the PATH.
echo "pinentry-program $pinentry_mac_path" >>"$gnupg_home"/gpg-agent.conf

# Avoid gpg warning:
# gpg: WARNING: unsafe permissions on homedir '~/.gnupg'
chmod 700 "$gnupg_home"
chmod 600 "$gnupg_home"/gpg-agent.conf
