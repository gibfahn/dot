#!/usr/bin/env zsh

# Create a case-sensitive volume for code shared between multiple macOS installs.

set -euo pipefail

set -x

shared_name=Shared-Data
shared_volume=/Volumes/$shared_name

# Create a case-sensitive shared volume for code etc.
if [[ ! -d $shared_volume ]]; then
  this_disk=$(/usr/libexec/PlistBuddy -c "print APFSContainerReference" =(diskutil info -plist /))
  diskutil apfs addVolume $this_disk 'Case-sensitive APFS' $shared_name
fi

. "$(dirname "$0")"/../../helpers/cleanup.zsh

# Things that are useful in every macOS install: code, and bulky caches and toolchains that don't
# depend on the macOS version. Each is linked from its default path, so tools find them as normal.
# Not shared: anything tied to the OS or Xcode version (Homebrew, Bazel output bases, DerivedData).
dirs_to_move=(
  ~/code
  ~/src

  ~/.cache/bazel-disk-cache   # Content-addressed, so safe to share.
  ~/.cache/bazel-repositories # Content-addressed, so safe to share.
  ~/.cache/uv
  ~/.cache/yarn
  ~/.cargo
  ~/.gradle
  ~/.npm
  ~/.rustup
  ~/go
  ~/Library/Caches/bazelisk
  ~/Library/Caches/com.apple.gib.liv # Restore images etc.
  ~/Library/Caches/pip
)

work_done=
for dir in $dirs_to_move; do
  [[ -L $dir ]] && continue

  # e.g. /Users/gib/code -> /Volumes/Shared-Data/Users/gib/code
  shared_dir=${shared_volume}${dir}

  # If directory not present skip it, unless another install already shared it.
  [[ -d $dir || -d $shared_dir ]] || continue

  work_done=true
  # Merges into shared_dir if another install already shared it.
  cleanup::migrate $dir $shared_dir
  mkdir -p $shared_dir ${dir:h}
  ln -s $shared_dir $dir
done

if [[ -z ${work_done:-} ]]; then
  exit "$UP_EXIT_CODE_SKIPPED"
fi
