#!/usr/bin/env zsh

set -eu

autoload -U colors && colors

usage() {
  echo "$(
    tput bold
    tput setaf 74
  )$ZSH_ARGZERO [OPTIONS] [pr number] $(tput sgr0)

git fetch pr: fetch and set up a PR branch.

Given no args, force updates the current branch to the relevant PR.

git fp 123    -> Create a branch called 'pull/123/<owner>/<PR branch name>' and set the base/push remotes accordingly.
git fp --remote up 123 -> As above, but look up the PR on remote 'up'.
git fp        -> Update the current branch (assumed to be a PR branch created by this script).
git ptp       -> push to the PR author's branch (in my git config as an alias).

Creates and updates local branches of the form pull/<PR Number>/<owner>/<PR Branch Name>, e.g.
pull/123/alice/myfeaturebranch. Use \`git ptp\` to push to the PR branch.

branch.<branch>.remote/merge track the PR's base branch (so rebase/status work), while
branch.<branch>.pushRemote is the author's fork.

If the PR author hasn't checked the 'maintainers can modify PR' checkbox, then the push branch won't be set up correctly.

OPTIONS:

--remote: name of the remote fetch the PR for, defaults to the git @{upstream} remote for the current branch.

"
}

if [[ -n ${DEBUG:-} ]]; then
  set -x
fi

up_remote=

while [[ $# != 0 ]]; do
  [[ ${1:-} =~ ^(--help|-h)$ ]] && {
    usage
    exit
  }

  [[ ${1:-} =~ ^(--version|-v)$ ]] && {
    echo "main"
    exit
  }

  [[ ${1:-} =~ ^(--quiet|-q)$ ]] && {
    QUIET=true
    shift
  }

  [[ ${1:-} =~ ^(--quiet|-q)$ ]] && {
    QUIET=true
    shift
  }

  [[ ${1:-} =~ ^--remote$ ]] && {
    up_remote=$2
    shift 2
    continue
  }

  [[ $# != 0 ]] && {
    pr_number=$1
    shift
    continue
  }

  [[ $# != 0 ]] && {
    echo "Too many args"
    usage
    exit 1
  }
done

main() {
  head_branch=$(git branch --show-current)

  if [[ -z ${up_remote:-} ]]; then
    up_remote=$(git rev-parse --abbrev-ref --symbolic-full-name @{u})
    up_remote=${up_remote%%/*}
  fi

  if [[ -n ${pr_number:-} ]]; then
    # Convert a URL like 'https://github.com/org/repo/pull/485/files' into '485'.
    pr_number=$(sed -E 's;.*/([0-9]+)/?(files)?$;\1;' <<<$pr_number)
  else
    # No PR number given: derive it from the current branch (assumed to be a git-fp PR branch).
    if ! [[ $head_branch =~ "^pull/[0-9]+/.+" ]]; then
      error "git-fp: Can't update branch as not on a PR branch we understand.
       Switch to a PR branch or provide a PR number as an argument to git fp"
    fi
    pr_number=${head_branch#pull/}
    pr_number=${pr_number%%/*}
  fi

  setup_branch
}

# Fetch (or update) the PR and set up a local branch for it.
#
# The local branch is named `pull/<pr_number>/<owner>/<pr_branch>`, e.g. `pull/123/alice/main`. The
# `<owner>/<pr_branch>` suffix makes it clearer which PR this is (vs just `pull/123/main`), and
#  is what `git ptp` (see the git alias) pushes back to: it strips the `pull/<n>/<owner>/` prefix
#     to recover `<pr_branch>` on the author's fork.
#
# `branch.<branch>.remote`/`.merge` are pointed at the PR's *base* branch so that `@{upstream}`,
# rebase, and status all work against what the PR will merge into. `branch.<branch>.pushRemote` is
# the author's fork, so `git ptp` pushes there.
setup_branch() {
  # TODO: stop setting this once `gh` gains decent upstream/push branch recognition.
  export GH_REPO=$(remote_url "$up_remote")
  export GH_HOST=$(remote_host "$up_remote")

  # Single API call for the owner, PR (head) branch, and base branch.
  local owner head_ref base_ref pr_meta
  pr_meta=$(gh pr view "$pr_number" --json headRefName,baseRefName,headRepositoryOwner \
    --jq '"owner=\(.headRepositoryOwner.login) head_ref=\(.headRefName) base_ref=\(.baseRefName)"') \
    || error "git-fp: Couldn't look up PR ${pr_number} on ${up_remote} (${GH_REPO})."
  eval "$pr_meta"

  local canonical=pull/$pr_number/$owner/$head_ref

  # Migrate any existing local branch for this PR to the canonical name (e.g. an old-scheme
  # `pull/<n>/<branch>` without the owner). Skip the canonical name itself so `--move` never
  # targets an existing branch.
  local existing
  existing=$(git branch --list --format '%(refname:short)' "pull/$pr_number/*" | grep -vx "$canonical" | head -n1)
  [[ -n $existing ]] && git branch --quiet --move "$existing" "$canonical"

  # Fetch/reset the PR head into the canonical branch and switch to it. `--force` makes this work
  # for both the first checkout and later updates. `gh pr checkout` also sets `remote`/`pushRemote`
  # to the author's fork.
  only_log_failure gh pr checkout --force --branch "$canonical" "$pr_number"

  # Capture the author's fork before we overwrite `remote` with the base repo below.
  local push_remote
  push_remote=$(git config branch.$canonical.pushRemote 2>/dev/null \
    || git config branch.$canonical.remote)

  # Track the PR's base branch. Set the config directly (rather than `--set-upstream-to`) so we
  # don't require `refs/remotes/$up_remote/$base_ref` to have been fetched yet.
  git config branch.$canonical.remote "$up_remote"
  git config branch.$canonical.merge "refs/heads/$base_ref"
  # Set the pushRemote so we can push to the PR branch with `git ptp`.
  git config branch.$canonical.pushRemote "$push_remote"

  head_branch=$canonical
  echo "git-fp: PR ${pr_number} ready as ${canonical} (base ${up_remote}/${base_ref})" >&2
}

only_log_failure() {
  # Don't only log failure if in debug mode.
  if [[ -n ${DEBUG:-} ]]; then
    "$@"
    return
  fi

  local output rc
  output=$("$@" 2>&1) && true
  rc=$?
  [[ $rc != 0 ]] && echo "Command '$*' failed with exit code $rc, output:
  $output" >&2
  return $rc
}

remote_url() {
  git remote get-url "$1"
}

# Remote hostname, used for setting GH_HOST.
remote_host() {
  git remote get-url ${1:?} | sed -e 's/^git@//' -e 's|https://||' -e 's/:.*//' -e 's|/.*||'
}

# Usage: exit message [rc]
error() {
  echo -e "${fg[red]}Error:${reset_color} $1" >&2
  exit "${2:-1}"
}

main "$@"
